{
    "name": "Node.js, TypeScript & PostgreSQL",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "postCreateCommand": "npm install && npx prisma migrate reset -f && sudo npx playwright install-deps && npx playwright install && npm install -g @anthropic-ai/claude-code",
    "customizations": {
        "vscode": {
            "extensions": [
                "GitHub.vscode-github-actions",
                "ms-playwright.playwright",
                "biomejs.biome",
                "ckolkman.vscode-postgres",
                "Prisma.prisma"
            ],
            "settings": {
                // https://biomejs.dev/reference/vscode/#default-formatter
				"editor.defaultFormatter": "biomejs.biome",
                // https://biomejs.dev/reference/vscode/#format-on-save
                "editor.formatOnSave": true,
                // Format on paste for immediate feedback
                "editor.formatOnPaste": true,
                // Format on type for real-time formatting
                "editor.formatOnType": true,
                "editor.codeActionsOnSave":{
                    // Import sorting on save is experimental, see: https://biomejs.dev/reference/vscode/#imports-sorting-experimental
                     // Decided to turn it off as it seemed to be introducing some syntax errors.
                     "source.organizeImports.biome": "never",
                     // Auto-fix linting issues on save
                     "source.fixAll.biome": "explicit"
                  }
			}
        }
    }
}