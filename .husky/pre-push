#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Running E2E tests before push..."

# Kill any existing dev servers to avoid port conflicts
lsof -ti:3000 | xargs kill -9 2>/dev/null || true

# Ensure Playwright browsers are installed
if ! npx playwright install --dry-run chromium >/dev/null 2>&1; then
  echo "Installing Playwright browsers..."
  npx playwright install chromium
fi

# Run quick E2E tests (chromium only, faster)
npm run e2e:quick

# If tests fail, the push will be aborted
if [ $? -ne 0 ]; then
  echo "❌ E2E tests failed! Push aborted."
  echo "Run 'npm run e2e:ui' to debug failing tests."
  exit 1
fi

echo "✅ E2E tests passed!"